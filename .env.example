ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://aurinara_platform:aurinara_platform@localhost:55433/aurinara_platform
OIDC_ISSUER=https://local-issuer.example
OIDC_AUDIENCE=aurinara-platform
OIDC_USER_AUDIENCES=aurinara-platform,aurinara,aurinara-edc,aurinara-edc-api,clinical-artifact-platform,clinical-edc
OIDC_JWKS_URL=http://localhost:8081/.well-known/jwks.json
OIDC_SERVICE_CLIENT_IDS=
OIDC_SERVICE_SCOPE=https://aurinara-platform.local/service
OIDC_SERVICE_AUDIENCE=https://aurinara-platform.local
OIDC_CLOCK_SKEW_SECONDS=30
BOOTSTRAP_FIRST_USER_AS_ADMIN=false
OBJECT_STORE_ENDPOINT=http://localhost:9200
OBJECT_STORE_BUCKET=aurinara-shared-objects
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
# Local MinIO has no KMS by default. Use AES256 or aws:kms outside local development.
OBJECT_STORE_SSE_ALGORITHM=none
# OBJECT_STORE_KMS_KEY_ID=
OBJECT_LOCK_ENABLED=false
OBJECT_LOCK_MODE=GOVERNANCE
MALWARE_SCAN_REQUIRED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
REPOSITORY_RICH_PREVIEW_ENABLED=true
REPOSITORY_CONVERSION_ENABLED=true
REPOSITORY_PDF_ANNOTATIONS_ENABLED=true
REPOSITORY_OFFICE_ENABLED=true
REPOSITORY_TABULAR_MAX_BYTES=1073741824
REPOSITORY_WORKER_MEMORY_LIMIT=512MB
REPOSITORY_WORKER_THREADS=2
REPOSITORY_QUERY_TIMEOUT_SECONDS=20
ONLYOFFICE_PUBLIC_URL=http://localhost:8083
ONLYOFFICE_INTERNAL_URL=http://localhost:8083
ONLYOFFICE_PLATFORM_URL=http://host.docker.internal:8002
ONLYOFFICE_JWT_SECRET=local-onlyoffice-change-me
EVENTBRIDGE_BUS_NAME=aurinara-platform
EVENTBRIDGE_ENDPOINT_URL=http://127.0.0.1:4567
# Optional locally; AWS injects the encrypted Cognito-confirmation queue URL.
# IDENTITY_REGISTRATION_QUEUE_URL=http://127.0.0.1:4567/000000000000/aurinara-platform-identity-registration
AWS_ENDPOINT_URL=http://127.0.0.1:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
