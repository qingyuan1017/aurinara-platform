ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://aurinara_platform:aurinara_platform@localhost:55433/aurinara_platform
OIDC_ISSUER=https://local-issuer.example
OIDC_AUDIENCE=aurinara-platform
OIDC_JWKS_URL=http://localhost:8081/.well-known/jwks.json
OIDC_SERVICE_CLIENT_IDS=
OIDC_SERVICE_SCOPE=https://aurinara-platform.local/service
OIDC_SERVICE_AUDIENCE=https://aurinara-platform.local
OIDC_CLOCK_SKEW_SECONDS=30
BOOTSTRAP_FIRST_USER_AS_ADMIN=false
OBJECT_STORE_ENDPOINT=http://localhost:9200
OBJECT_STORE_BUCKET=aurinara-shared-objects
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
# Local MinIO has no KMS by default. Use AES256 or aws:kms outside local development.
OBJECT_STORE_SSE_ALGORITHM=none
# OBJECT_STORE_KMS_KEY_ID=
OBJECT_LOCK_ENABLED=false
OBJECT_LOCK_MODE=GOVERNANCE
MALWARE_SCAN_REQUIRED=false
EVENTBRIDGE_BUS_NAME=aurinara-platform
EVENTBRIDGE_ENDPOINT_URL=http://127.0.0.1:4567
AWS_ENDPOINT_URL=http://127.0.0.1:4567
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
