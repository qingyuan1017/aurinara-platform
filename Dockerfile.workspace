FROM ghcr.io/coder/code-server:4.96.4@sha256:9c3f63f0b3b40217dc15c922a8fecce85bc180f13f7552ebe4076cc2d00e5f28

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      awscli ca-certificates curl git nodejs npm python3 python3-pip python3-venv r-base \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/workspace-ide-entrypoint.sh /usr/local/bin/workspace-ide
COPY scripts/workspace-sync-entrypoint.sh /usr/local/bin/workspace-sync
RUN chmod 0555 /usr/local/bin/workspace-ide /usr/local/bin/workspace-sync \
    && mkdir -p /workspace /home/coder/.local/share/aurinara-workspace \
    && chown coder:coder /workspace /home/coder/.local/share/aurinara-workspace

USER coder
WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["workspace-ide"]
